{
    "name": "dockge",
    "version": "1.5.0",
    "type": "module",
    "engines": {
        "node": ">= 24.0.0"
    },
    "scripts": {
        "fmt": "eslint \"**/*.{ts,vue}\" --fix",
        "lint": "eslint \"**/*.{ts,vue}\"",
        "check-ts": "tsc --noEmit",
        "start": "tsx ./backend/index.ts",
        "dev": "concurrently -k -r \"wait-on tcp:5000 && npm run dev:backend \" \"npm run dev:frontend\"",
        "dev:backend": "cross-env NODE_ENV=development tsx watch --inspect ./backend/index.ts",
        "dev:frontend": "cross-env NODE_ENV=development vite --host --config ./frontend/vite.config.ts",
        "release-final": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:frontend && npm run build:docker",
        "release-beta": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:frontend && npm run build:docker-beta",
        "build:frontend": "vite build --config ./frontend/vite.config.ts",
        "build:docker-base": "docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t krevoit/dockge:base -f ./docker/Base.Dockerfile . --push",
        "build:docker": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t krevoit/dockge:latest -t krevoit/dockge:1 -t krevoit/dockge:$VERSION -t krevoit/dockge:beta -t krevoit/dockge:nightly --target release -f ./docker/Dockerfile . --push",
        "build:docker-beta": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t krevoit/dockge:beta -t krevoit/dockge:$VERSION --target release -f ./docker/Dockerfile . --push",
        "build:docker-nightly": "npm run build:frontend && docker buildx build --platform linux/amd64,linux/arm64,linux/arm/v7 -t krevoit/dockge:nightly --target nightly -f ./docker/Dockerfile . --push",
        "build:healthcheck": "docker buildx build -f docker/BuildHealthCheck.Dockerfile --platform linux/amd64,linux/arm64,linux/arm/v7 -t krevoit/dockge:build-healthcheck . --push",
        "start-docker": "docker run --rm -p 5001:5001 --name dockge krevoit/dockge:latest",
        "mark-as-nightly": "tsx ./extra/mark-as-nightly.ts",
        "reformat-changelog": "tsx ./extra/reformat-changelog.ts",
        "reset-password": "tsx ./extra/reset-password.ts"
    },
    "dependencies": {
        "@homebridge/node-pty-prebuilt-multiarch": "0.14.1",
        "@inventage/envsubst": "^0.16.0",
        "bcryptjs": "~2.4.3",
        "check-password-strength": "~2.0.10",
        "command-exists": "~1.2.9",
        "compare-versions": "~6.1.1",
        "composerize": "~1.7.6",
        "croner": "~8.1.2",
        "dayjs": "~1.11.13",
        "dotenv": "~16.3.2",
        "express": "~4.22.3",
        "express-static-gzip": "~2.1.8",
        "http-graceful-shutdown": "~3.1.14",
        "jsonwebtoken": "~9.0.2",
        "jwt-decode": "~3.1.2",
        "knex": "~3.3.0",
        "limiter-es6-compat": "~2.1.2",
        "mysql2": "~3.24.3",
        "openid-client": "~6.8.8",
        "promisify-child-process": "~4.1.2",
        "redbean-node": "^0.4.0",
        "semver": "^7.7.1",
        "socket.io": "~4.8.1",
        "socket.io-client": "~4.8.1",
        "sqlite3": "6.0.1",
        "timezones-list": "~3.0.3",
        "ts-command-line-args": "~2.5.1",
        "tsx": "~4.23.15",
        "type-fest": "~4.3.3",
        "yaml": "~2.8.3"
    },
    "devDependencies": {
        "@codemirror/lang-python": "^6.1.7",
        "@codemirror/lang-yaml": "^6.1.2",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/ibm-plex-sans": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.2.5",
        "@fortawesome/fontawesome-svg-core": "6.4.2",
        "@fortawesome/free-regular-svg-icons": "6.4.2",
        "@fortawesome/free-solid-svg-icons": "6.4.2",
        "@fortawesome/vue-fontawesome": "3.0.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/bootstrap": "~5.2.10",
        "@types/command-exists": "~1.2.3",
        "@types/express": "~4.17.21",
        "@types/jsonwebtoken": "~9.0.9",
        "@types/semver": "^7.7.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "bootstrap": "5.3.2",
        "bootstrap-vue-next": "~0.14.10",
        "codemirror": "^6.0.1",
        "concurrently": "^8.2.2",
        "cross-env": "~7.0.3",
        "eslint": "^10.12.0",
        "eslint-plugin-jsdoc": "^65.3.2",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "sass": "~1.105.1",
        "thememirror": "^2.0.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.4",
        "vite-plugin-compression": "~0.5.1",
        "vue": "~3.5.13",
        "vue-codemirror6": "^1.3.13",
        "vue-eslint-parser": "^10.4.1",
        "vue-i18n": "11.4.14",
        "vue-qrcode": "~2.2.2",
        "vue-router": "~4.5.0",
        "vue-toastification": "2.0.0-rc.5",
        "wait-on": "^7.2.0"
    },
    "overrides": {
        "core-js": "3.50.0"
    }
}
